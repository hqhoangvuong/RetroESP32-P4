# Default ESP32-P4 silicon profile for this repository.
# Rev3.x uses ESP-IDF's revision-aware MIPI PLL reference selection and 250 MHz PSRAM.
CONFIG_ESP32P4_REV_MIN_300=y
# CONFIG_ESP32P4_REV_MIN_100 is not set
# CONFIG_ESP32P4_REV_MIN_1 is not set
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_SPIRAM_SPEED_250M=y
# CONFIG_SPIRAM_SPEED_200M is not set
