menu "RetroESP32 Platform"

    config HDMI_OUTPUT
        bool "Use HDMI output (LT8912) instead of LCD (ST7701)"
        default n
        help
            When enabled, the display pipeline outputs to an HDMI monitor
            via the LT8912 MIPI-to-HDMI bridge at 640x480 RGB888.
            When disabled (default), the display outputs to the ST7701
            480x800 MIPI DSI LCD panel.

    config BOARD_WAVESHARE_P4_43
        bool "Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 (instead of Guition 4.3-inch LCD)"
        default n
        depends on !HDMI_OUTPUT
        help
            Select the Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 pin map and
            panel configuration for the handheld (LCD) build.  Changes the
            LCD reset / backlight pins and polarity, ST7701 init sequence and
            DPI timing, audio PA / I2S pins, battery ADC and the GPIO-pad X
            button.  When disabled (default) the Guition 4.3-inch board is used.
            Rev3.x ESP32-P4 silicon additionally needs sdkconfig.p4rev3.defaults.

    config LT8912_I2C_SDA
        int "LT8912 I2C SDA GPIO"
        default 7
        depends on HDMI_OUTPUT

    config LT8912_I2C_SCL
        int "LT8912 I2C SCL GPIO"
        default 8
        depends on HDMI_OUTPUT

    config LT8912_RESET_GPIO
        int "LT8912 Reset GPIO"
        default 23
        depends on HDMI_OUTPUT

endmenu
